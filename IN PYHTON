total_students = 0
passed = 0
failed = 0

while True:
    name = input("Whats your name?: ")
    age = int(input("How old are you?: "))
    sub1 = int(input("HCI Grade (0-100): "))
    sub2 = int(input("CC103 Grade (0-100): "))
    sub3 = int(input("Net1 Grade (0-100): "))

    total = sub1 + sub2 + sub3
    average = total / 3
    print(f"Average: {average:.2f}")

    total_students += 1

    if average < 75:
        print("Status: Failed!")
        failed += 1
    else:
        print("Status: Passed!")
        passed += 1

    choice = input("\nDo you want to enter another student (Y/N)? ")

    if choice.upper() == "Y":
        print()
        continue

    elif choice.upper() == "N":
        break

    else:
        print("Invalid choice!")
        break

print("===========================")
print("       CLASS SUMMARY")
print("===========================")
print(f"Total Students: {total_students}")
print(f"Students Passed: {passed}")
print(f"Students Failed: {failed}")
print("\nProgram terminated. Thank you!")
